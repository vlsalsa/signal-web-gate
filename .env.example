# Non-secret deployment settings only. Replace placeholders before starting.
# Keep all credentials and password hashes in ./secrets, never here.
GATE_TEAM=https://YOUR_TEAM.cloudflareaccess.com
GATE_AUD=REPLACE_WITH_ACCESS_APPLICATION_AUD
GATE_ALLOWED_EMAIL=REPLACE_WITH_ALLOWED_EMAIL
GATE_ORIGIN=https://signal.example.com
GATE_UPSTREAM=http://signal-web:3000
# Must match scripts/generate-upstream-basic.sh's username argument.
UPSTREAM_USER=signal
PUID=3005
PGID=3005
TZ=Etc/UTC
